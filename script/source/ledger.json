    {
      "id": "lfs:chapter07/kernfs",
      "sha": "835caa8b701bc8ecaa68bd5ac12cc1f911c84d618b7e7e88097834a7052c6cb7",
      "status": "unaudited",
      "disposition": "deviation",
      "reason": "Vorpal mounts no virtual file systems: step::bwrap in sdk/rust/src/artifact/step.rs gives each step a new /dev, /proc, and a tmpfs /tmp, and the bwrap arguments in linux_vorpal.rs bind the rootfs directories; /sys and /run are not mounted."
    },
    {
      "id": "lfs:chapter07/chroot",
      "sha": "db9eb470e8eeee8b3b6b50f86113bab34187d821d479ce59091d52bb38aaf26e",
      "status": "unaudited",
      "disposition": "deviation",
      "reason": "Each stage runs under bubblewrap instead of chroot: step::bwrap in sdk/rust/src/artifact/step.rs clears the environment (--clearenv), the bwrap arguments in linux_vorpal.rs bind the rootfs directories and run as uid and gid 0, step_environments sets PATH=/usr/bin:/usr/sbin, and each stage script sets MAKEFLAGS in its Setup environment block in place of the env list of the chroot command."
    },
