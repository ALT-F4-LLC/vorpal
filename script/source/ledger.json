  "deviations": [
    {
      "package": "*",
      "kind": "subset",
      "detail": "linux-vorpal builds only the packages listed under kind=linux-vorpal in registry.json, not the full LFS chapter 5-8 set.",
      "reason": "The rootfs is a build environment for Vorpal artifacts, not a bootable system."
    },
    {
      "package": "bash, binutils, bison, coreutils, gawk, gettext, glibc, gmp, grep, gzip, libunistring, m4, make, mpc, patch, sed, tar, texinfo",
      "kind": "archive-format",
      "detail": "Mirrored as the upstream .tar.gz instead of the book's .tar.xz where both exist.",
      "reason": "Historic mirror keys; each .tar.gz is published by the same upstream with its own signature. A bump should switch to the book's archive when the helper in source.rs allows it."
    },
    {
      "package": "coreutils",
      "kind": "patch-omitted",
      "detail": "coreutils-9.7-upstream_fix-1.patch and coreutils-9.7-i18n-1.patch from the 12.4 Needed Patches are not applied.",
      "reason": "Not yet reviewed against the stage_02/stage_04 scripts; the next book move must diff these commands."
    },
    {
      "package": "unzip",
      "kind": "not-in-book",
      "detail": "BLFS 12.4 and 13.1 no longer carry UnZip (only libarchive's bsdunzip). The consolidated_fixes-1 and gcc14-1 patches come from the BLFS patches archive, and stage_05 writes an inline gcc15.patch that is in no Needed Patches list.",
      "reason": "Open: patches outside the tracked Needed Patches violate the patch rule. The skill stops on unzip until the operator chooses bsdunzip (BLFS libarchive) or records an exception here."
    },
    {
      "package": "curl-cacert",
      "kind": "not-in-book",
      "detail": "Mozilla CA bundle from https://curl.se/ca/ instead of BLFS make-ca's certdata.txt.",
      "reason": "Upstream source with a published SHA-256; version is the bundle's date."
    },
    {
      "package": "python",
      "kind": "patch-omitted",
      "detail": "Any Python-*.patch listed in Needed Patches for the tracked book is not applied.",
      "reason": "None listed for 12.4; 13.1 lists Python-3.14.7-openssl_4-1.patch, which the move to 13.1 must add."
    },
    {
      "package": "python",
      "kind": "authority",
      "detail": "Declared authority is the SHA-256 in python.org's SPDX SBOM next to the tarball; the book MD5 is the stated fallback.",
      "reason": "python.org signs 3.14 releases with Sigstore only and the skill has no Sigstore verifier. The pinned 3.13.7 still ships a PGP .asc, which the declared authority does not use, so one authority covers the move to 3.14. The SBOM shares an origin with the tarball, like the uv, perl, and cacert checksum files."
    }
  ],
