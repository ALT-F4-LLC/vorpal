---
// The 404 page's search form and site map (docs-redesign stage 4,
// template 14). Search first: the form opens the site search with the words
// from the missing path, or what the reader typed. It needs JavaScript;
// without it a line points to the site map, which is always shown here.
import SidebarTree from './SidebarTree.astro';

const { sections, extra } = Astro.locals.vorpalNav;
const all = [...sections, ...extra].filter((s) => s.group);
---

<form class="vp-sbox vp-jsonly" role="search" data-vp-nf>
	<label class="sr-only" for="vp-nf-q">Search the docs</label>
	<input id="vp-nf-q" name="q" type="search" placeholder="A page, a flag, or paste an error" />
	<button class="vp-btn" type="submit">Search</button>
</form>
<p class="vp-nojsonly">Search needs JavaScript. <a href="#sitemap">Every page, by section</a> works without it.</p>

<slot />

<section class="vp-nf-map" aria-labelledby="sitemap">
	<h2 id="sitemap">Every page, by section</h2>
	<div class="vp-sitemap">
	{
		all.map((s) => (
			<div>
				<h3>{s.label}</h3>
				<SidebarTree entries={s.group!.entries} />
			</div>
		))
	}
	</div>
</section>

<script>
	// Open Starlight's search dialog and type the query into Pagefind's box,
	// which loads when the browser is idle, so wait briefly for it.
	function openSearch(query: string) {
		const open = document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]');
		if (!open) return;
		open.click();
		const started = Date.now();
		const fill = () => {
			const input = document.querySelector<HTMLInputElement>('#starlight__search .pagefind-ui__search-input');
			if (input) {
				input.value = query;
				input.dispatchEvent(new Event('input', { bubbles: true }));
				input.focus();
			} else if (Date.now() - started < 3000) {
				setTimeout(fill, 50);
			}
		};
		fill();
	}
	const form = document.querySelector<HTMLFormElement>('[data-vp-nf]');
	const input = form?.querySelector<HTMLInputElement>('input');
	if (form && input) {
		// The missing path, as words: /guides/run-a-job/ -> "run a job".
		const words = decodeURIComponent(location.pathname)
			.split('/')
			.filter(Boolean)
			.pop()
			?.replace(/\.html?$/, '')
			.replace(/[-_]+/g, ' ');
		if (words && words !== '404') input.value = words;
		form.addEventListener('submit', (event) => {
			event.preventDefault();
			openSearch(input.value.trim());
		});
	}
</script>
