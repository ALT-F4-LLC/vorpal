---
// Page footer (docs-redesign stage 4, design-system.md §12, §13).
//
// - Related: cards from frontmatter `related` (collection ids, checked at
//   build time, so a moved page fails the build).
// - Previous and Next: Starlight's Pagination; route data keeps them only in
//   an ordered section (src/route-data.ts).
// - Edit this page (Starlight's `editUrl`, from `editLink` in the config)
//   and Last updated. The date comes
//   from frontmatter `lastUpdated` only: Starlight's own `lastUpdated` reads
//   git, and the vorpal-website artifact builds without a .git directory.
// - View as Markdown: the page's Markdown copy, written at build time by
//   src/integrations/markdown-twins.mjs. With JavaScript, "Copy as Markdown"
//   puts the same text on the clipboard.
// - A site map built from the sidebar config, shown only without JavaScript
//   (with it, the header and Menu carry navigation), plus links that are
//   not in the header and the version line.
import { getEntry } from 'astro:content';
import { Icon } from '@astrojs/starlight/components';
import Pagination from '@astrojs/starlight/components/Pagination.astro';
import SidebarTree from '../SidebarTree.astro';
import { flatten } from '../../nav';
import { LATEST_RELEASE } from '../../versions.mjs';
import { markdownPath } from '../../markdown-path.mjs';

const { entry, lang, editUrl } = Astro.locals.starlightRoute;
const { sections, extra, snapshot } = Astro.locals.vorpalNav;
// On a version snapshot's page: that release (src/versions.mjs).
const shown = snapshot?.release ?? LATEST_RELEASE;
const allSections = [...sections, ...extra];
const isSplash = entry.data.template === 'splash';

const mdHref = markdownPath(Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`);

const lastUpdated = entry.data.lastUpdated instanceof Date ? entry.data.lastUpdated : undefined;

const related = (
	await Promise.all((entry.data.related ?? []).map((ref) => getEntry(ref)))
).flatMap((page) => {
	if (!page) return [];
	const href = page.id === 'index' ? '/' : `/${page.id}/`;
	const section = allSections.find(
		(s) => s.group && flatten(s.group.entries).some((l) => l.href.endsWith(href)),
	);
	return [
		{
			href,
			title: page.data.title,
			type: section?.label,
			text: page.data.summary ?? page.data.description,
		},
	];
});
---

<footer class="vp-footer" data-pagefind-ignore="all">
	{
		related.length > 0 && (
			<section class="vp-related" aria-labelledby="vp-related-h">
				<h2 id="vp-related-h">Related</h2>
				<ul class="vp-cards">
					{related.map((r) => (
						<li class="vp-card">
							{r.type && <span class="vp-card-type">{r.type}</span>}
							<a href={r.href}>
								{r.title}
								<span class="vp-card-arrow" aria-hidden="true">
									→
								</span>
							</a>
							{r.text}
						</li>
					))}
				</ul>
			</section>
		)
	}

	<Pagination />

	{
		!isSplash && (
			<div class="vp-pfoot">
				<a href={mdHref} type="text/markdown">
					<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.7" />
						<path
							d="M6.5 15V9l2.5 3 2.5-3v6M15 9v6M13 13l2 2 2-2"
							fill="none"
							stroke="currentColor"
							stroke-width="1.6"
							stroke-linejoin="round"
							stroke-linecap="round"
						/>
					</svg>
					View as Markdown
				</a>
				<button type="button" class="vp-pfoot-btn vp-jsonly" data-vp-copy-md={mdHref}>
					<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<rect x="8" y="8" width="12" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="1.7" />
						<path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" fill="none" stroke="currentColor" stroke-width="1.7" />
					</svg>
					<span>Copy as Markdown</span>
				</button>
				{editUrl && (
					<a href={editUrl}>
						<Icon name="pencil" size="1rem" />
						Edit this page
					</a>
				)}
				{lastUpdated && (
					<p class="vp-updated">
						Last updated{' '}
						<time datetime={lastUpdated.toISOString().slice(0, 10)}>
							{lastUpdated.toLocaleDateString(lang, { dateStyle: 'medium', timeZone: 'UTC' })}
						</time>
					</p>
				)}
			</div>
		)
	}

	<nav class="vp-sitefoot print:hidden" aria-label="Site map">
		<div class="vp-sitemap vp-nojsonly">
			{
				allSections.map((s) => (
					<div>
						<h2>
							<a href={s.href}>{s.label}</a>
						</h2>
						{s.group && <SidebarTree entries={s.group.entries} />}
					</div>
				))
			}
		</div>
		<ul class="vp-footlinks">
			<li><a href="/reference/contributing/">Contribute to the docs</a></li>
			<li><a href={`https://github.com/ALT-F4-LLC/vorpal/releases/tag/${shown}`}>Release notes</a></li>
			<li><a href="https://github.com/ALT-F4-LLC/vorpal">GitHub</a></li>
		</ul>
		<p class="vp-vline">Docs for {snapshot ? snapshot.release : 'main'} · Latest release {LATEST_RELEASE}</p>
	</nav>
</footer>

<script>
	import { say } from '../../scripts/live';

	// Copy as Markdown: fetch the page's Markdown copy and put it on the
	// clipboard. The fetch is passed to ClipboardItem as a promise, so Safari
	// keeps the click's permission while it loads.
	document.querySelectorAll<HTMLButtonElement>('[data-vp-copy-md]').forEach((button) => {
		const label = button.querySelector('span')!;
		const text = () =>
			fetch(button.dataset.vpCopyMd!).then((r) => {
				if (!r.ok) throw new Error(String(r.status));
				return r.text();
			});
		button.addEventListener('click', async () => {
			try {
				if (typeof ClipboardItem !== 'undefined' && navigator.clipboard?.write) {
					const blob = text().then((t) => new Blob([t], { type: 'text/plain' }));
					await navigator.clipboard.write([new ClipboardItem({ 'text/plain': blob })]);
				} else {
					await navigator.clipboard.writeText(await text());
				}
				label.textContent = 'Copied';
				say('Page copied as Markdown.');
			} catch {
				label.textContent = 'Copy failed';
				say('Could not copy. Use View as Markdown instead.');
			}
			setTimeout(() => (label.textContent = 'Copy as Markdown'), 1600);
		});
	});
</script>
