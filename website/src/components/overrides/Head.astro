---
// Starlight's <head>, plus the self-hosted fonts: @font-face rules (with
// font-display: optional and metric-matched fallbacks) and a preload for
// each file. See `fonts` in astro.config.mjs.
//
// Also marks <html class="vp-js"> before first paint, so controls that need
// JavaScript (the Menu, the SDK select) show without a layout shift, and
// their no-JS fallbacks (the "Sections" disclosure below 50rem, the footer
// site map) hide.
//
// The SDK script runs here too, first in <head> and before Starlight's
// stylesheets, so <html data-sdk> picks the example panels before first
// paint (src/scripts/sdk-head.ts).
//
// Last, a link to the page's Markdown copy, and noindex on a version
// snapshot's pages.
import { Font } from 'astro:assets';
import Default from '@astrojs/starlight/components/Head.astro';
import { SDK_HEAD_SCRIPT } from '../../scripts/sdk-head';
import { markdownPath } from '../../markdown-path.mjs';
import { snapshotOf } from '../../versions.mjs';

// The page's Markdown copy (src/integrations/markdown-twins.mjs), for tools
// that look for one. The 404 page has none.
const path = Astro.url.pathname;
const markdown =
	Astro.locals.starlightRoute.entry.data.kind === 'not-found'
		? undefined
		: markdownPath(path.endsWith('/') ? path : `${path}/`);
// A version snapshot (src/versions.mjs) is a frozen copy of main's pages:
// search engines should send readers to main, which is also in the sitemap.
const noindex = !!snapshotOf(path);
---

<script is:inline set:html={`document.documentElement.classList.add('vp-js');${SDK_HEAD_SCRIPT}`} />
<Default />
<Font cssVariable="--font-instrument-sans" preload />
<Font cssVariable="--font-jetbrains-mono" preload />
{noindex && <meta name="robots" content="noindex, follow" />}
{markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
