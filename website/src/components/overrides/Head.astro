---
// Starlight's <head>, plus the self-hosted fonts: @font-face rules (with
// font-display: optional and metric-matched fallbacks) and a preload for
// each file. See `fonts` in astro.config.mjs.
//
// Also marks <html class="vp-js"> before first paint, so controls that need
// JavaScript (the Menu, the SDK select) show without a layout shift, and
// their no-JS fallbacks (the "Sections" disclosure below 50rem, the footer
// site map) hide.
import { Font } from 'astro:assets';
import Default from '@astrojs/starlight/components/Head.astro';
---

<script is:inline>document.documentElement.classList.add('vp-js');</script>
<Default />
<Font cssVariable="--font-instrument-sans" preload />
<Font cssVariable="--font-jetbrains-mono" preload />
