---
/**
 * Phone-only "Browse the docs" menu for the splash homepage.
 *
 * Starlight's splash template has no sidebar, so on narrow screens the
 * homepage has no menu button and no way to reach the docs navigation.
 * This renders the same sidebar entries (from Starlight's route data, so it
 * never drifts from `sidebar` in astro.config.mjs) inside a native
 * <details> disclosure. It is hidden at 50rem and wider, where the
 * desktop layout is unchanged.
 */
import type { StarlightRouteData } from '@astrojs/starlight/route-data';

type Entry = StarlightRouteData['sidebar'][number];

interface Props {
	entries?: Entry[];
}

const entries = Astro.props.entries ?? Astro.locals.starlightRoute.sidebar;
const isRoot = !Astro.props.entries;
---

{
	isRoot ? (
		<nav class="docs-browse not-content" aria-labelledby="docs-browse-label" data-pagefind-ignore>
			<details>
				<summary id="docs-browse-label">Browse the docs</summary>
				<Astro.self entries={entries} />
			</details>
		</nav>
	) : (
		<ul>
			{entries.map((entry) =>
				entry.type === 'link' ? (
					<li>
						<a href={entry.href} {...entry.attrs}>
							{entry.label}
						</a>
					</li>
				) : (
					<li>
						<span class="docs-browse-group">{entry.label}</span>
						<Astro.self entries={entry.entries} />
					</li>
				),
			)}
		</ul>
	)
}
