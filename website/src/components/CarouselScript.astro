<script is:inline>
// SDK language tabs (WAI-ARIA Tabs pattern, automatic activation).
// Selection changes only when the reader picks a tab; nothing advances on
// its own (WCAG 2.2.2). Unselected panels get `hidden`, which removes them
// and their controls from the accessibility tree and the tab order.
// Without JS every panel stays visible and the tab row is not shown.
document.addEventListener('DOMContentLoaded', () => {
  const carousel = document.querySelector('[data-carousel]');
  if (!carousel) return;

  const tabs = [...carousel.querySelectorAll('[role="tab"]')];
  const panels = [...carousel.querySelectorAll('[role="tabpanel"]')];

  function select(index) {
    tabs.forEach((t, i) => {
      const selected = i === index;
      t.setAttribute('aria-selected', selected ? 'true' : 'false');
      t.setAttribute('tabindex', selected ? '0' : '-1');
    });
    panels.forEach((p, i) => {
      p.hidden = i !== index;
      p.classList.toggle('active', i === index);
    });
  }

  const initial = Math.max(0, tabs.findIndex(t => t.getAttribute('aria-selected') === 'true'));
  select(initial);
  carousel.classList.add('sdk-carousel--active');

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(i));
  });

  carousel.querySelector('[role="tablist"]').addEventListener('keydown', (e) => {
    let idx = tabs.indexOf(document.activeElement);
    if (idx < 0) return;
    if (e.key === 'ArrowRight') idx = (idx + 1) % tabs.length;
    else if (e.key === 'ArrowLeft') idx = (idx - 1 + tabs.length) % tabs.length;
    else if (e.key === 'Home') idx = 0;
    else if (e.key === 'End') idx = tabs.length - 1;
    else return;
    e.preventDefault();
    select(idx);
    tabs[idx].focus();
  });
});
</script>
